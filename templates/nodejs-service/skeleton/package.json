{
  "name": "${{ values.name }}",
  "version": "1.0.0",
  "private": true,
  "description": ${{ values.description | dump }},
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node -r newrelic src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "5.3.0",
    "newrelic": "14.10.0",
    "serverless-http": "4.0.0"
  }
}
